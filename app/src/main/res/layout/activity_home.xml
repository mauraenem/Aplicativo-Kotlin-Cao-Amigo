<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐶"
        android:textSize="70sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cão Amigo"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bem-vindo ao Cão Amigo!"
        android:textSize="20sp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnListaCaes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LISTA DE CÃES"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnRegistroCuidado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REGISTRO DE CUIDADO"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnHistoricoCuidado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HISTÓRICO DE CUIDADOS" />

</LinearLayout>