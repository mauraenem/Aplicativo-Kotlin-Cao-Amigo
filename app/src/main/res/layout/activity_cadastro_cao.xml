<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro do Cão"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <ImageButton
            android:id="@+id/imgFotoCao"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Adicionar foto do cão"
            android:scaleType="centerInside"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque na imagem para anexar a foto do cão"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtNomeCao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do cão"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtIdadeCao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Idade do cão"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtRua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rua"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtBairro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bairro"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtMunicipio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Município"
            android:inputType="textCapWords"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSalvarCao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALVAR CÃO" />

    </LinearLayout>

</ScrollView>